{
  "setup": [
    "cp .env.example .env"
  ],
  "teardown": [
    "QA_PROJECT=mortgage-qa-$(basename \"$PWD\") scripts/qa-stack.sh down"
  ],
  "run": [
    "QA_PROJECT=mortgage-qa-$(basename \"$PWD\") scripts/qa-stack.sh up --data \"${TMPDIR:-/tmp}/mortgage-qa-$(basename \"$PWD\")/data\" --backups \"${TMPDIR:-/tmp}/mortgage-qa-$(basename \"$PWD\")/backups\""
  ]
}
