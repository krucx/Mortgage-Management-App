# Copy to .env and adjust. Paths are folders on this laptop.

# Database and photos live here. Back this folder up!
DATA_DIR=./data

# Backups are written here; point it at a Google Drive / iCloud synced folder.
BACKUP_DIR=./backups

# Password for the Backup zips. Keep it somewhere safe: without it a Backup cannot be
# opened. Leave empty for unencrypted Backups (not recommended in a synced folder).
BACKUP_PASSWORD=

# Time zone used for every business date (Accrual Dates, "today").
TZ=Asia/Kolkata

# Open the app at http://localhost:<APP_PORT>
APP_PORT=8080

# Which release to run, e.g. 1.2.0. Leave empty for the latest one.
APP_VERSION=
