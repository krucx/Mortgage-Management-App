{
  "name": "mortgage-frontend",
  "private": true,
  "version": "3.4.10",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr.mjs && vite",
    "build": "tsc -b && node scripts/copy-ocr.mjs && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:types": "cd ../backend && uv run python -m mortgage_backend.openapi ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json -o src/api.gen.ts",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
