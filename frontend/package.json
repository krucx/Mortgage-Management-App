{
  "name": "mortgage-frontend",
  "private": true,
  "version": "3.4.4",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr.mjs && vite",
    "build": "tsc -b && node scripts/copy-ocr.mjs && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:types": "cd ../backend && uv run python -m mortgage_backend.openapi ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json -o src/api.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
